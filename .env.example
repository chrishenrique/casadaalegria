# Instagram Basic Display API
# Siga o guia em: https://developers.facebook.com/docs/instagram-basic-display-api/getting-started
#
# Passos rápidos:
# 1. Acesse developers.facebook.com → criar app (tipo "Consumer")
# 2. Adicione o produto "Instagram Basic Display"
# 3. Em "User Token Generator", adicione sua conta @_casadaalegria como usuário de teste
# 4. Clique em "Generate Token" → copie o short-lived token
# 5. Troque pelo long-lived token (válido 60 dias, renovável):
#    curl -X GET "https://graph.instagram.com/access_token
#      ?grant_type=ig_exchange_token
#      &client_secret=SEU_APP_SECRET
#      &access_token=SEU_SHORT_LIVED_TOKEN"
# 6. Cole o long-lived token abaixo
# 7. Para pegar seu USER_ID: curl "https://graph.instagram.com/me?access_token=SEU_TOKEN"

INSTAGRAM_ACCESS_TOKEN=seu_long_lived_token_aqui
INSTAGRAM_USER_ID=seu_instagram_user_id_aqui
