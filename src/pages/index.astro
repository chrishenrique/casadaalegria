---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import About from '../components/About.astro';
import Diferencial from '../components/Diferencial.astro';
import InstagramReel from '../components/InstagramReel.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout>
  <Header />
  <main>
    <Hero />
    <Stats />
    <About />
    <Diferencial />
    <Services />
    <Gallery />
    <Testimonials />
    <WhatsAppCTA />
    <InstagramReel
      permalink="https://www.instagram.com/reel/DZV0RfbB7_s/?utm_source=ig_embed&utm_campaign=loading"
      tag="No Instagram"
      title="Acompanhe nossas festas! 🎉"
      subtitle="Veja mais momentos mágicos que criamos e inspire-se para a festa do seu pequeno."
    />
    <Contact />
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>
