<style>
  .wa-cta {
    background: linear-gradient(135deg, #1a8c45 0%, #25d366 60%, #20c760 100%);
    position: relative;
    overflow: hidden;
    padding: 80px 20px;
  }

  .wa-cta-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .deco {
    position: absolute;
    font-size: 3rem;
    opacity: 0.15;
  }
  .d1 { top: 10%; left: 5%; animation: float 5s ease-in-out infinite; }
  .d2 { top: 15%; right: 8%; animation: float2 6s ease-in-out infinite 1s; }
  .d3 { bottom: 20%; left: 15%; animation: float3 4.5s ease-in-out infinite 0.5s; }
  .d4 { bottom: 10%; right: 10%; animation: float 5.5s ease-in-out infinite 2s; }
  .d5 { top: 50%; left: 50%; animation: float2 4s ease-in-out infinite 0.8s; }

  .wa-cta-content {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
  }

  .wa-icon-wrap {
    width: 90px;
    height: 90px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  }

  .wa-cta-text { flex: 1; min-width: 240px; }

  .wa-cta-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: white;
    margin-bottom: 0.75rem;
  }

  .wa-cta-sub {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1rem;
    line-height: 1.7;
  }

  .wa-cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .btn-white {
    background: white;
    color: #1a8c45;
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 1rem;
    padding: 16px 28px;
    border-radius: 50px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    transition: all 0.3s;
    text-decoration: none;
    white-space: nowrap;
  }
  .btn-white:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 14px 36px rgba(0,0,0,0.25);
  }

  .wa-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.85rem;
    font-weight: 700;
    gap: 2px;
  }

  @media (max-width: 768px) {
    .wa-cta-content {
      flex-direction: column;
      text-align: center;
    }
    .wa-cta-actions { width: 100%; }
    .btn-white { width: 100%; justify-content: center; }
  }
</style>
