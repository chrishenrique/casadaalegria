---
const photos = [
  { seed: 'kids-party1',  alt: 'Festa de aniversário temática colorida',       w: 600, h: 400, span: 'wide' },
  { seed: 'kids-party2',  alt: 'Decoração com balões e enfeites',              w: 400, h: 400, span: '' },
  { seed: 'kids-party3',  alt: 'Bolo de aniversário temático',                 w: 400, h: 300, span: '' },
  { seed: 'kids-party4',  alt: 'Crianças brincando na área lúdica',            w: 400, h: 400, span: '' },
  { seed: 'kids-party5',  alt: 'Mesa de doces e guloseimas',                   w: 400, h: 300, span: '' },
  { seed: 'kids-party6',  alt: 'Salão decorado para festa temática',           w: 600, h: 400, span: 'wide' },
  { seed: 'kids-party7',  alt: 'Animação infantil com personagens',            w: 400, h: 400, span: '' },
  { seed: 'kids-party8',  alt: 'Festa com tema de princesas',                  w: 400, h: 300, span: '' },
  { seed: 'kids-party9',  alt: 'Crianças comemorando com balões',              w: 400, h: 400, span: '' },
];
---

<section id="galeria" class="gallery" aria-label="Galeria de fotos">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-tag">Galeria</span>
      <h2 class="section-title">Momentos que Encantam! 📸</h2>
      <p class="section-subtitle">
        Cada foto conta uma história de alegria, amor e celebração. Confira alguns dos
        momentos mágicos que já vivemos juntos.
      </p>
    </div>

    <div class="gallery-grid reveal">
      {photos.map((p) => (
        <div class={`gallery-item ${p.span}`} data-lightbox>
          <img
            src={`https://picsum.photos/seed/${p.seed}/${p.w}/${p.h}`}
            alt={p.alt}
            loading="lazy"
            width={p.w}
            height={p.h}
          />
          <div class="gallery-overlay">
            <span class="overlay-icon">🔍</span>
            <p class="overlay-alt">{p.alt}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="gallery-cta reveal">
      <p>Quer ver mais festas incríveis?</p>
      <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        📷 Ver no Instagram
      </a>
    </div>
  </div>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Visualizar foto">
    <button class="lb-close" id="lbClose" aria-label="Fechar">✕</button>
    <img src="" alt="" class="lb-img" id="lbImg" />
  </div>
</section>

<style>
  .gallery { background: var(--bg); }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .section-header .section-subtitle { margin: 0 auto; }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 2.5rem;
  }

  .gallery-item {
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    cursor: zoom-in;
    background: #e8d5ff;
    aspect-ratio: 4/3;
  }

  .gallery-item.wide {
    grid-column: span 2;
    aspect-ratio: 16/9;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
    display: block;
  }

  .gallery-item:hover img { transform: scale(1.07); }

  .gallery-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(155, 93, 229, 0.8), rgba(255, 107, 157, 0.8));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    opacity: 0;
    transition: opacity 0.3s ease;
    padding: 16px;
  }
  .gallery-item:hover .gallery-overlay { opacity: 1; }

  .overlay-icon { font-size: 2.4rem; }
  .overlay-alt {
    color: white;
    font-size: 0.85rem;
    font-weight: 700;
    text-align: center;
    line-height: 1.4;
  }

  .gallery-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 24px;
    background: white;
    border-radius: 20px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  }
  .gallery-cta p { font-weight: 700; font-size: 1rem; color: var(--text-light); }

  /* Lightbox */
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .lightbox.open { display: flex; }

  .lb-img {
    max-width: 90vw;
    max-height: 85vh;
    border-radius: 16px;
    object-fit: contain;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    animation: reveal 0.3s ease;
  }

  .lb-close {
    position: fixed;
    top: 20px;
    right: 24px;
    background: white;
    border: none;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    font-size: 1.1rem;
    cursor: pointer;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    transition: transform 0.2s;
  }
  .lb-close:hover { transform: scale(1.1); }

  @media (max-width: 700px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
    .gallery-item.wide { grid-column: span 2; }
  }
  @media (max-width: 440px) {
    .gallery-grid { grid-template-columns: 1fr; }
    .gallery-item.wide { grid-column: 1; }
  }
</style>

<script>
  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const lbImg = document.getElementById('lbImg') as HTMLImageElement;
  const lbClose = document.getElementById('lbClose');

  document.querySelectorAll('.gallery-item').forEach((item) => {
    item.addEventListener('click', () => {
      const img = item.querySelector('img') as HTMLImageElement;
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      lightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
    });
  });

  const closeLb = () => {
    lightbox.classList.remove('open');
    document.body.style.overflow = '';
    lbImg.src = '';
  };

  lbClose?.addEventListener('click', closeLb);
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLb(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLb(); });
</script>
